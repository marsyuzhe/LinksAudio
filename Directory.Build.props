<Project><PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><LangVersion>latest</LangVersion><NuGetAudit>true</NuGetAudit><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType><PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap></PropertyGroup><Target Name="UseSourceBuiltLameForTests" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)src/LinksAudio.Codecs/native/libmp3lame.64.dll')"><Copy SourceFiles="$(MSBuildThisFileDirectory)src/LinksAudio.Codecs/native/libmp3lame.64.dll" DestinationFolder="$(TargetDir)"/></Target></Project>
